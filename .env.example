# Required. Groq: https://console.groq.com/keys (free). Exa: https://dashboard.exa.ai/api-keys (free credits).
GROQ_API_KEY=
EXA_API_KEY=

# Optional. Without these, memory lives in a local SQLite file (verbatim.db).
TURSO_URL=
TURSO_TOKEN=

# Optional, deploy only. API: allowed CORS origins, comma separated. Web: where the API lives.
FRONTEND_ORIGINS=*
VITE_API_URL=
